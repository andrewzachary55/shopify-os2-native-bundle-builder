{%- comment -%}
  Shopify OS 2.0 Native 1-Click Bundle Builder (MIT)
  Zero third-party apps · Zero jQuery · Works with Dawn & any OS 2.0 theme
  Source: https://codekit-studio.pages.dev/
{%- endcomment -%}

{{ 'bundle-drawer.css' | asset_url | stylesheet_tag }}

<section id="bundle-builder-{{ section.id }}" class="ck-section">
  <div class="ck-container">
    <div
      class="ck-bundle"
      data-ck-bundle
      data-discount-pct="{{ section.settings.discount_pct }}"
      data-currency-symbol="{{ cart.currency.symbol | default: '$' }}"
    >
      <div class="ck-bundle__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="ck-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="ck-h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.subtext != blank -%}
            <p class="ck-muted">{{ section.settings.subtext }}</p>
          {%- endif -%}
        </div>
        <span class="ck-badge">
          {{ section.settings.badge_prefix }} {{ section.settings.discount_pct }}%
        </span>
      </div>

      <div class="ck-bundle__grid">
        {%- for block in section.blocks -%}
          {%- assign prod = block.settings.product -%}
          {%- assign variant = prod.selected_or_first_available_variant -%}
          <label class="ck-bundle-item" {{ block.shopify_attributes }}>
            <input
              type="checkbox"
              checked
              data-ck-bundle-check
              data-variant-id="{{ variant.id | default: '' }}"
              data-price="{{ variant.price | default: prod.price | default: block.settings.fallback_price_cents }}"
            >
            <div class="ck-bundle-item__info">
              <span class="ck-slot-label">{{ block.settings.slot_label }}</span>
              <strong>{{ prod.title | default: block.settings.fallback_title }}</strong>
              <span class="ck-mono" dir="ltr">
                {%- if prod != blank -%}
                  {{ variant.price | default: prod.price | money }}
                {%- else -%}
                  {{ block.settings.fallback_price_label }}
                {%- endif -%}
              </span>
            </div>
          </label>
        {%- endfor -%}
      </div>

      <div class="ck-bundle__footer">
        <div>
          <span class="ck-muted">{{ section.settings.total_label }}</span>
          <strong class="ck-bundle__total ck-mono" data-ck-bundle-total dir="ltr">$0.00</strong>
        </div>
        <button type="button" class="ck-btn ck-btn--primary" data-ck-bundle-submit>
          {{ section.settings.button_label }}
        </button>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'bundle-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Native Bundle Builder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "1-CLICK SETUP BUNDLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build Your Kit & Save 15%" },
    { "type": "textarea", "id": "subtext", "label": "Description", "default": "Select the products you need and add the full compatible bundle to your cart in one click." },
    { "type": "text", "id": "badge_prefix", "label": "Savings Badge Prefix", "default": "Save" },
    { "type": "range", "id": "discount_pct", "label": "Preview Discount % (match Shopify Automatic Discount)", "min": 5, "max": 35, "step": 5, "default": 15 },
    { "type": "text", "id": "total_label", "label": "Total Label", "default": "Estimated bundle total" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Add Selected Bundle to Cart" }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle Product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify Product" },
        { "type": "text", "id": "slot_label", "label": "Slot Label", "default": "01 · CORE ITEM" },
        { "type": "text", "id": "fallback_title", "label": "Fallback Title (Editor Preview)", "default": "Flagship Product" },
        { "type": "number", "id": "fallback_price_cents", "label": "Fallback Price (cents)", "default": 19900 },
        { "type": "text", "id": "fallback_price_label", "label": "Fallback Display Price", "default": "$199.00" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Native Bundle Builder",
      "blocks": [
        { "type": "bundle_item", "settings": { "slot_label": "01 · AUDIO", "fallback_title": "Arc Pro ANC Headphones", "fallback_price_cents": 29900, "fallback_price_label": "$299.00" } },
        { "type": "bundle_item", "settings": { "slot_label": "02 · INPUT", "fallback_title": "K75 CNC Mechanical Keyboard", "fallback_price_cents": 18900, "fallback_price_label": "$189.00" } },
        { "type": "bundle_item", "settings": { "slot_label": "03 · POWER", "fallback_title": "Core 240W GaN Desk Dock", "fallback_price_cents": 12900, "fallback_price_label": "$129.00" } }
      ]
    }
  ]
}
{% endschema %}
